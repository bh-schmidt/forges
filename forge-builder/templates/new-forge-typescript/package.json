{
    "name": "{{forgeId}}",
    "description": "{{forgeDescription}}",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "clear": "rm -rf dist",
        "build": "tsc && tsc-alias",
        "rebuild": "npm run clear && npm run build",
        "watch": "nodemon --watch scripts --ext * --exec npm run build"
    },
    "keywords": [],
    "files": [
        "dist",
        "templates"
    ],
    "dependencies": {},
    "devDependencies": {},
    "forge": {
        "name": "{{forgeName}}",
        "description": "{{forgeDescription}}",
        "{{defaultTaskId}}": {
            "name": "{{defaultTaskName}}",
            "description": "{{defaultTaskDescription}}",
            "default": true
        }
    }
}